{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contract-first-systems/task-contract.schema.json",
  "title": "Task contract (key fields)",
  "description": "Lightweight JSON Schema for contract-first task contracts. See docs/standard.md for normative rules.",
  "type": "object",
  "required": [
    "task_id",
    "version",
    "summary",
    "supervisor",
    "time_bounds",
    "execution_identities",
    "allowed_paths",
    "allowed_operations",
    "success_criteria",
    "verification",
    "stop_conditions",
    "escalation",
    "blast_radius"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique id for this task across retries."
    },
    "version": {
      "type": "string",
      "description": "Contract or standard version, e.g. 1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "supervisor": {
      "type": "string",
      "description": "Accountable approver (user, team, or role id)."
    },
    "intent": {
      "type": "string"
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "time_bounds": {
      "type": "object",
      "properties": {
        "not_before": { "type": "string" },
        "not_after": { "type": "string" },
        "max_duration": { "type": "string", "description": "e.g. 2h, 15m" }
      },
      "additionalProperties": true
    },
    "identity_selection": {
      "type": "object",
      "description": "Supervisor record: use an existing allowed identity or create a new one before execution; rationale ties expertise and boundary to the task.",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["use_existing", "create_new"],
          "description": "Whether an existing identity was selected or a new named identity was created for this task."
        },
        "chosen_execution_id": {
          "type": "string",
          "description": "Primary execution_id bound for this run after selection."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this identity's expertise/domain and boundary fit the task, or why creation was required."
        },
        "expertise_match_notes": {
          "type": "string",
          "description": "Optional detail on domain fit, tool familiarity, or risk."
        }
      },
      "required": ["decision", "rationale"],
      "additionalProperties": true
    },
    "boundary_monitoring": {
      "type": "object",
      "description": "Anti-blur checkpoints during execution; restate identity boundary and contract limits.",
      "properties": {
        "checkpoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "When to re-verify scope, e.g. time triggers, step counts, or before side effects."
        }
      },
      "additionalProperties": true
    },
    "execution_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["execution_id", "role"],
        "properties": {
          "execution_id": { "type": "string" },
          "display_name": {
            "type": "string",
            "description": "Human-meaningful name paired with execution_id."
          },
          "role": { "type": "string" },
          "runtime": { "type": "string" },
          "visual_marker": {
            "type": "string",
            "description": "Emoji and/or color or UI token for operator recognition."
          },
          "expertise_domain": {
            "type": "string",
            "description": "What this identity is for on this task (skills, repos, risk class)."
          },
          "communication_style": {
            "type": "string",
            "description": "Expected reporting style for this identity."
          },
          "execution_boundary": {
            "type": "string",
            "description": "Precise in-scope vs out-of-scope statement for this identity on this task."
          },
          "allowed_resources": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Narrow list of paths, tools, accounts aligned with the contract."
          },
          "forbidden_resources": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Explicit denies for this identity; must not exceed contract exclusions."
          },
          "executor_stop_conditions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Identity-level halt triggers aligned with contract stop_conditions."
          },
          "executor_escalation": {
            "type": "object",
            "description": "Identity-level escalation path; payload should include task_id and execution_id.",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Path or resource prefix allow list; empty array means no file/path mutation."
    },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["read", "write", "delete", "exec", "api_call", "send_message", "other"]
      }
    },
    "side_effect_channels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "side_effect_limits": {
      "type": "object",
      "additionalProperties": true
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "verification": {
      "type": "object",
      "properties": {
        "automated": {
          "type": "array",
          "items": { "type": "string" }
        },
        "human_signoff": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "who": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "escalation": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "blast_radius": {
      "type": "string",
      "minLength": 1
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": true
    },
    "supersedes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
